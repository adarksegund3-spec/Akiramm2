local corRefs = {}
local function setActiveColorBorder(ativo)
    for _, r in ipairs(corRefs) do
        r.stroke.Transparency = (r.color == ativo) and 0 or 0.7
        r.stroke.Thickness = (r.color == ativo) and 2 or 1
    end
end

