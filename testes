local function Farm_GarantirVelocity(hrp)
    local att = hrp:FindFirstChild("FarmAtt")
    if not att then
        att = Instance.new("Attachment")
        att.Name = "FarmAtt"
        att.Parent = hrp
    end
    local lv = hrp:FindFirstChild("FarmLV")
