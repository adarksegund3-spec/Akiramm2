local KNIFE_KEYWORDS = {"knife","faca","blade","lâmina","lamina","punhal","dagger"}
local GUN_KEYWORDS   = {"gun","revolver","pistol","arma","pistola","luger","m9","firearm","handgun","sidearm"}

local function checkKeyword(name, keywords)
    if not name then return false end
    local n = name:lower()
    for _, kw in ipairs(keywords) do
        if n:find(kw, 1, true) then return true end
    end
    return false
end

local function getPlayerRole(player)
    local char = player.Character
    local bp   = player:FindFirstChildOfClass("Backpack")
    local hasKnife, hasGun = false, false
    local function check(tool)
        if not tool or not tool:IsA("Tool") then return end
        if checkKeyword(tool.Name, KNIFE_KEYWORDS) then hasKnife = true end
        if checkKeyword(tool.Name, GUN_KEYWORDS)   then hasGun   = true end
    end
    if char then
        for _, o in ipairs(char:GetChildren()) do check(o) end
        for _, o in ipairs(char:GetDescendants()) do if o:IsA("Tool") then check(o) end end
    end
    if bp then
        for _, o in ipairs(bp:GetChildren()) do check(o) end
        for _, o in ipairs(bp:GetDescendants()) do if o:IsA("Tool") then check(o) end end
    end
    if hasKnife then return "Murderer" end
    if hasGun then return "Sheriff" end
    return "Innocent"
end

local function getRoleColor(player)
    return ROLE_COLORS[getPlayerRole(player)] or ROLE_COLORS.Innocent
end

