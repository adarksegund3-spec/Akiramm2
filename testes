    if not Farm_MoverPara(destino) then return false end
    task.wait(0.35)
    local destinoFinal = destino
    local pinConn = RunService.RenderStepped:Connect(function()
        local c = LocalPlayer.Character
        if not c then return end
        local h = c:FindFirstChild("HumanoidRootPart")
        if not h then return end
        h.CFrame = CFrame.new(destinoFinal)
        h.AssemblyLinearVelocity = Vector3.zero
        h.AssemblyAngularVelocity = Vector3.zero
    end)
    local partes = {"Head", "HumanoidRootPart", "LeftFoot", "RightFoot", "LeftLeg", "RightLeg"}
    local fim = os.clock() + FARM_VERIFY_TIMEOUT
    local coletou = false
    while os.clock() < fim do
        local c = LocalPlayer.Character
        if not c then break end
        if firetouchinterest then
            for _, nome in ipairs(partes) do
                local parte = c:FindFirstChild(nome)
                if parte then
                    pcall(function()
                        firetouchinterest(parte, coin, 0)
                        firetouchinterest(parte, coin, 1)
                    end)
                end
            end
        end
        if not coin or not coin.Parent then coletou = true; break end
        if coin:GetAttribute("Collected") == true then coletou = true; break end
        task.wait(0.08)
    end
    destinoFinal = Vector3.new(destinoFinal.X, coin.Position.Y + 4, destinoFinal.Z)
    task.wait(0.15)
    if pinConn then pinConn:Disconnect(); pinConn = nil end
    task.spawn(function()
        task.wait(0.4)
        local c = LocalPlayer.Character
        if not c then return end
        local h = c:FindFirstChild("HumanoidRootPart")
        if not h then return end
        if h.Position.Y < FARM_VOID_Y then
            if Farm.PosInicial then
                pcall(function() c:PivotTo(Farm.PosInicial) end)
            end
        end
    end)
    return coletou
end

local function Farm_Parar()
    Farm.Ativo = false
    Farm.Rodando = false
    if LocalPlayer.Character then Farm_LimparVelocity(LocalPlayer.Character) end
    Noclip_Stop(true)
end

local function Farm_Iniciar()
    if Farm.Rodando then return end
    Farm.Rodando = true
    Farm.Ativo = true
    Farm.Coletadas = 0
    Noclip_Start(true)
    local char = LocalPlayer.Character
    if char then
        local hrp = char:FindFirstChild("HumanoidRootPart")
        if hrp then Farm.PosInicial = hrp.CFrame end
    end
    task.spawn(function()
        while Farm.Ativo do
            task.wait(0.5)
            local c = LocalPlayer.Character
            if c then
                local h = c:FindFirstChild("HumanoidRootPart")
                if h and h.Position.Y < FARM_VOID_Y then
                    if Farm.PosInicial then
                        pcall(function() c:PivotTo(Farm.PosInicial) end)
                    end
                    task.wait(0.5)
                end
            end
        end
    end)
    task.spawn(function()
        while Farm.Ativo do
            local char = LocalPlayer.Character
            local hrp = char and char:FindFirstChild("HumanoidRootPart")
            local hum = char and char:FindFirstChildOfClass("Humanoid")
            if not char or not hrp or not hum or hum.Health <= 0 then
                task.wait(0.5)
            else
                local moedas = Farm_ListarMoedas()
                if #moedas == 0 then
                    task.wait(1)
                    moedas = Farm_ListarMoedas()
                    if #moedas == 0 then
                        if Farm.PosInicial then
                            pcall(function() char:PivotTo(Farm.PosInicial) end)
                        end
                        Farm.Ativo = false
                        break
                    end
                else
                    local myPos = hrp.Position
                    table.sort(moedas, function(a, b)
                        return (a.Position - myPos).Magnitude < (b.Position - myPos).Magnitude
                    end)
                    for _, coin in ipairs(moedas) do
                        if not Farm.Ativo then break end
                        if coin and coin.Parent and coin:GetAttribute("Collected") ~= true then
                            if Farm_ColetarMoeda(coin) then
                                Farm.Coletadas = Farm.Coletadas + 1
                            end
                        end
                        task.wait(FARM_DELAY_ENTRE_MOEDAS)
                    end
                end
            end
            task.wait(0.1)
        end
        Farm.Rodando = false
        if LocalPlayer.Character then Farm_LimparVelocity(LocalPlayer.Character) end
        Noclip_Stop(true)
    end)
end

--═══════════════ FARM FÍSICO ═══════════════
local function FF_CleanupConns()
    if FarmFisico.HeartbeatConn then FarmFisico.HeartbeatConn:Disconnect(); FarmFisico.HeartbeatConn = nil end
    if FarmFisico.ConnAdded then FarmFisico.ConnAdded:Disconnect(); FarmFisico.ConnAdded = nil end
    if FarmFisico.ConnRemoved then FarmFisico.ConnRemoved:Disconnect(); FarmFisico.ConnRemoved = nil end
    if FarmFisico.ConnStarted then FarmFisico.ConnStarted:Disconnect(); FarmFisico.ConnStarted = nil end
    if FarmFisico.ConnCollected then FarmFisico.ConnCollected:Disconnect(); FarmFisico.ConnCollected = nil end
end

local function FF_StopMovement()
    if FarmFisico.LinearVelocity then
        FarmFisico.LinearVelocity.VectorVelocity = Vector3.zero
        FarmFisico.LinearVelocity.Enabled = false
    end
    local root = LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("HumanoidRootPart")
    if root then
        root.AssemblyLinearVelocity = Vector3.zero
        root.AssemblyAngularVelocity = Vector3.zero
    end
end

local function FF_SetupVel()
    local root = LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("HumanoidRootPart")
    if not root then return end
    FarmFisico.Attachment = root:FindFirstChild("FarmAttachment")
    if not FarmFisico.Attachment then
        FarmFisico.Attachment = Instance.new("Attachment")
        FarmFisico.Attachment.Name = "FarmAttachment"
        FarmFisico.Attachment.Parent = root
    end
    FarmFisico.LinearVelocity = root:FindFirstChild("FarmLinearVelocity")
    if not FarmFisico.LinearVelocity then
        FarmFisico.LinearVelocity = Instance.new("LinearVelocity")
        FarmFisico.LinearVelocity.Name = "FarmLinearVelocity"
        FarmFisico.LinearVelocity.Attachment0 = FarmFisico.Attachment
        FarmFisico.LinearVelocity.VelocityConstraintMode = Enum.VelocityConstraintMode.Vector
        FarmFisico.LinearVelocity.RelativeTo = Enum.ActuatorRelativeTo.World
        FarmFisico.LinearVelocity.VectorVelocity = Vector3.zero
        FarmFisico.LinearVelocity.Enabled = false
        FarmFisico.LinearVelocity.ForceLimitMode = Enum.ForceLimitMode.PerAxis
        FarmFisico.LinearVelocity.MaxAxesForce = Vector3.new(100000, 100000, 100000)
        FarmFisico.LinearVelocity.Parent = root
    end
end

local function FF_RemoveVel()
    if FarmFisico.LinearVelocity then FarmFisico.LinearVelocity:Destroy(); FarmFisico.LinearVelocity = nil end
    if FarmFisico.Attachment then FarmFisico.Attachment:Destroy(); FarmFisico.Attachment = nil end
end

local function FF_IsCoin(part)
    if not part:IsA("BasePart") then return false end
    if FarmFisico.Blacklist[part] then return false end
    local n = part.Name:lower()
    return n:find("coin") or n:find("cash") or n:find("money") or n:find("collect")
end

local function FF_CheckBagFull()
    local pg = LocalPlayer:FindFirstChild("PlayerGui")
    if not pg then return false end
    for _, gui in ipairs(pg:GetChildren()) do
        if gui:IsA("ScreenGui") and gui.Name ~= "AKZ_Menu_MM2" and gui.Name ~= "AKZ_Toast" then
            local container = gui:FindFirstChild("Container", true)
            if container then
                for _, frame in ipairs(container:GetChildren()) do
                    if frame:IsA("Frame") and frame.Visible then
                        local fullIcon = frame:FindFirstChild("FullBagIcon", true)
                        local fullText = frame:FindFirstChild("Full", true)
                        if (fullIcon and fullIcon.Visible) or (fullText and fullText.Visible) then
                            return true
                        end
                    end
                end
            end
        end
    end
    return false
end

local function FF_TriggerBagFullReset()
    if FarmFisico.BagFull then return end
    FarmFisico.BagFull = true
    FF_StopMovement()
    task.wait(0.2)
    local char = LocalPlayer.Character
    local hum = char and char:FindFirstChildOfClass("Humanoid")
    if hum and hum.Health > 0 then hum.Health = 0 end
    showToast("🎒 BOLSA CHEIA", "Resetando personagem", WARN_CLR)
end

local function FF_InitListeners()
    FarmFisico.ActiveCoins = {}
    for _, v in ipairs(workspace:GetDescendants()) do
        if FF_IsCoin(v) then FarmFisico.ActiveCoins[v] = true end
    end
    FarmFisico.ConnAdded = workspace.DescendantAdded:Connect(function(part)
        if FF_IsCoin(part) then FarmFisico.ActiveCoins[part] = true end
    end)
    FarmFisico.ConnRemoved = workspace.DescendantRemoving:Connect(function(part)
        FarmFisico.ActiveCoins[part] = nil
        if FarmFisico.CurrentTarget == part then FarmFisico.CurrentTarget = nil end
    end)
    local remotes = ReplicatedStorage:FindFirstChild("Remotes")
    local gameplay = remotes and remotes:FindFirstChild("Gameplay")
    if gameplay then
        local coinsStarted = gameplay:FindFirstChild("CoinsStarted")
        local coinCollected = gameplay:FindFirstChild("CoinCollected")
        if coinsStarted then
            FarmFisico.ConnStarted = coinsStarted.OnClientEvent:Connect(function()
                FarmFisico.WaitingForCoins = true
                FF_StopMovement()
                FarmFisico.CurrentTarget = nil
                FarmFisico.ActiveCoins = {}
                FarmFisico.Blacklist = {}
                FarmFisico.NoCoinsStart = nil
                FarmFisico.BagFull = false
                task.wait(FF.RoundStartDelay)
                for _, v in ipairs(workspace:GetDescendants()) do
                    if FF_IsCoin(v) then FarmFisico.ActiveCoins[v] = true end
                end
                FarmFisico.WaitingForCoins = false
            end)
        end
        if coinCollected then
            FarmFisico.ConnCollected = coinCollected.OnClientEvent:Connect(function(_, cur, mx)
                local c = tonumber(cur)
                local m = tonumber(mx)
                if c and m and c >= m then FF_TriggerBagFullReset() end
            end)
        end
    end
end

local function FF_StartTargetFinder()
    if FarmFisico.TargetFinderThr then task.cancel(FarmFisico.TargetFinderThr) end
    FarmFisico.TargetFinderThr = task.spawn(function()
        while FarmFisico.Loaded do
            task.wait(0.1)
            if FarmFisico.Ativo and not FarmFisico.BagFull and FF_CheckBagFull() then
                FF_TriggerBagFullReset()
            end
            if FarmFisico.Ativo and not FarmFisico.BagFull and not FarmFisico.WaitingForCoins then
                local char = LocalPlayer.Character
                local root = char and char:FindFirstChild("HumanoidRootPart")
                if root then
                    local rootPos = root.Position
                    local nearest, nearestDist = nil, FF.MaxDist + 1
                    for coin in pairs(FarmFisico.ActiveCoins) do
                        if coin and coin.Parent and not FarmFisico.Blacklist[coin] then
                            local dist = (coin.Position - rootPos).Magnitude
                            if dist < nearestDist then
                                nearestDist = dist
                                nearest = coin
                            end
                        else
                            FarmFisico.ActiveCoins[coin] = nil
                        end
                    end
                    if nearest and not nearest:FindFirstChild("CoinVisual") then
                        FarmFisico.ActiveCoins[nearest] = nil
                        nearest = nil
                    end
                    FarmFisico.CurrentTarget = nearest
                end
            end
        end
    end)
end

local function FF_CheckStuck(root, targetPos, now)
    if not FarmFisico.LastPos then
        FarmFisico.LastPos = root.Position
        FarmFisico.StuckTime = now
        return
    end
    local moved = (root.Position - FarmFisico.LastPos).Magnitude
    if moved < 0.5 then
        if now - FarmFisico.StuckTime >= FF.StuckThreshold then
            local myPos = root.Position
            local dir = (targetPos - myPos)
            dir = Vector3.new(dir.X, 0, dir.Z)
            if dir.Magnitude > 0.1 then
                local step = dir.Unit * math.min(FF.UnstickStep, dir.Magnitude)
                local newPos = myPos + step + Vector3.new(0, 1, 0)
                pcall(function() LocalPlayer.Character:PivotTo(CFrame.new(newPos)) end)
            end
            FarmFisico.StuckTime = now
            FarmFisico.LastPos = root.Position
        end
    else
        FarmFisico.LastPos = root.Position
        FarmFisico.StuckTime = now
    end
end

local function FF_StartEngine()
    FF_CleanupConns()
    FF_SetupVel()
    FF_InitListeners()
    FarmFisico.NoCoinsStart = nil
    FarmFisico.LastPos = nil
    FarmFisico.StuckTime = os.clock()
    FarmFisico.HeartbeatConn = RunService.Heartbeat:Connect(function()
        if not FarmFisico.Ativo or FarmFisico.BagFull or FarmFisico.WaitingForCoins then
            FF_StopMovement()
            return
        end
        local char = LocalPlayer.Character
        local root = char and char:FindFirstChild("HumanoidRootPart")
        local hum = char and char:FindFirstChildOfClass("Humanoid")
        if not root or not root.Parent or not hum or hum.Health <= 0 then
            FF_StopMovement()
            return
        end
        if FarmFisico.CurrentTarget and FarmFisico.CurrentTarget.Parent
           and not FarmFisico.Blacklist[FarmFisico.CurrentTarget] then
            FarmFisico.NoCoinsStart = nil
            local targetPos = FarmFisico.CurrentTarget.Position
            local rootPos = root.Position
            local dist = (targetPos - rootPos).Magnitude
            if dist <= 2.0 then
                root.CFrame = CFrame.new(targetPos + Vector3.new(0, 1, 0))
                FF_StopMovement()
                FarmFisico.CollectedLife = true
                FarmFisico.Blacklist[FarmFisico.CurrentTarget] = true
                FarmFisico.ActiveCoins[FarmFisico.CurrentTarget] = nil
                FarmFisico.CurrentTarget = nil
                FarmFisico.Coletadas = FarmFisico.Coletadas + 1
                FarmFisico.LastPos = nil
            else
                FF_CheckStuck(root, targetPos, os.clock())
                if FarmFisico.LinearVelocity then
                    FarmFisico.LinearVelocity.Enabled = true
                    FarmFisico.LinearVelocity.VectorVelocity = (targetPos - rootPos).Unit * FF.TargetSpeed
                end
            end
        else
            FF_StopMovement()
            FarmFisico.LastPos = nil
            if FarmFisico.CollectedLife then
                if not FarmFisico.NoCoinsStart then
                    FarmFisico.NoCoinsStart = os.clock()
                elseif os.clock() - FarmFisico.NoCoinsStart >= FF.ResetDelay then
                    FarmFisico.NoCoinsStart = nil
                    FF_CleanupConns()
                    if hum.Health > 0 then hum.Health = 0 end
                end
            else
                FarmFisico.NoCoinsStart = nil
            end
        end
    end)
end

local function FarmFisico_Parar()
    FarmFisico.Ativo = false
    FarmFisico.Loaded = false
    FarmFisico.BagFull = false
    FarmFisico.WaitingForCoins = false
    FarmFisico.CollectedLife = false
    FarmFisico.LastPos = nil
    FarmFisico.StuckTime = 0
    FF_CleanupConns()
    FF_StopMovement()
    FF_RemoveVel()
    if FarmFisico.TargetFinderThr then
        task.cancel(FarmFisico.TargetFinderThr)
        FarmFisico.TargetFinderThr = nil
    end
    Noclip_Stop(true)
end

local function FarmFisico_Iniciar()
    FarmFisico.Ativo = true
    FarmFisico.Loaded = true
    FarmFisico.Coletadas = 0
    FarmFisico.BagFull = false
    FarmFisico.LastPos = nil
    FarmFisico.StuckTime = os.clock()
    Noclip_Start(true)
