local function Noclip_Start(force)
    if force then NoclipState.ForceState = true end
    if NoclipState.Conn then return end
    NoclipState.Ativo = true
    NoclipState.Conn = RunService.Stepped:Connect(function()
        if not NoclipState.Ativo then return end
        local char = LocalPlayer.Character
        if not char then return end
        local hum = char:FindFirstChildOfClass("Humanoid")
        if not hum or hum.Health <= 0 then return end
        for _, part in ipairs(char:GetChildren()) do
            if part:IsA("BasePart") and part.CanCollide then part.CanCollide = false end
        end
    end)
end

local function Noclip_Stop(force)
    if force then NoclipState.ForceState = false end
    if NoclipState.ForceState then return end
    NoclipState.Ativo = false
    if NoclipState.Conn then NoclipState.Conn:Disconnect(); NoclipState.Conn = nil end
    local char = LocalPlayer.Character
    if char then
        for _, part in ipairs(char:GetChildren()) do
            if part:IsA("BasePart") then part.CanCollide = true end
        end
    end
end

local function Noclip_Set(ativo)
    if ativo then Noclip_Start(false) else Noclip_Stop(false) end
end

local function AntiAFK_Set(ativo)
    AntiAFKState.Ativo = ativo
    if ativo then
        task.spawn(function()
            while AntiAFKState.Ativo do
                task.wait(30)
                if not AntiAFKState.Ativo then break end
                pcall(function()
                    VirtualUser:CaptureController()
                    VirtualUser:ClickButton2(Vector2.new())
                end)
            end
        end)
    end
end

