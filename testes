local function applyTheme(newColor)
    local oldAccent = Theme.Accent
    Theme.Accent = newColor
    Theme.AccentDim = newColor:Lerp(Color3.new(0,0,0), 0.35)
    local function swap(root)
        for _, d in ipairs(root:GetDescendants()) do
            pcall(function() if d.BackgroundColor3 == oldAccent then d.BackgroundColor3 = newColor end end)
            pcall(function() if d.TextColor3 == oldAccent then d.TextColor3 = newColor end end)
            pcall(function() if d:IsA("UIStroke") and d.Color == oldAccent then d.Color = newColor end end)
            pcall(function()
                if d:IsA("ScrollingFrame") and d.ScrollBarImageColor3 == oldAccent then d.ScrollBarImageColor3 = newColor end
            end)
        end
    end
    swap(menuFrame)
    swap(logo)
    pcall(function() if logoStroke.Color == oldAccent then logoStroke.Color = newColor end end)
end

