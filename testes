end

--════════════ GunDrop ════════════
local GunDrop = GunDropConfig

local function ehGun(obj)
    if not obj or not obj.Parent then return false end
    if not obj:IsA("BasePart") then return false end
    local p = obj
    while p and p ~= workspace do
        if p:IsA("Model") and Players:GetPlayerFromCharacter(p) then return false end
        p = p.Parent
    end
    local match = checkKeyword(obj.Name, GUN_KEYWORDS)
    if not match then
        for _, c in ipairs(obj:GetChildren()) do
            if checkKeyword(c.Name, GUN_KEYWORDS) then match = true; break end
        end
    end
    if not match and obj.Parent then
        match = checkKeyword(obj.Parent.Name, GUN_KEYWORDS)
    end
    if not match then return false end
    return obj:FindFirstChildOfClass("TouchTransmitter") ~= nil
        or obj:FindFirstChild("TouchInterest") ~= nil
end

local function GunDrop_Processar(obj)
    if not obj or not obj.Parent then return end
    if GunDrop.ObjetosVistos[obj] then return end
    if not ehGun(obj) then return end
    GunDrop.ObjetosVistos[obj] = true
    GunDrop.Total = GunDrop.Total + 1
    GunDrop.UltimaGun = obj
    GunDrop.ObjetosMonitorados[obj] = true
    local agora = tick()
    local debounce = (agora - GunDrop.UltimoAviso) < 1.5
    GunDrop.UltimoAviso = agora
    if GunDrop.ESPAtivo then
        if GunDrop.HighlightAtual then pcall(function() GunDrop.HighlightAtual:Destroy() end) end
        local hl = Instance.new("Highlight")
        hl.Name = "AKZ_GunDrop_HL"
        hl.Adornee = obj
        hl.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop
        hl.FillColor = WARN_CLR
        hl.OutlineColor = Color3.fromRGB(255, 240, 200)
        hl.FillTransparency = 0.4
        hl.OutlineTransparency = 0
        hl.Parent = obj
        GunDrop.HighlightAtual = hl
    end
    if GunDrop.AvisoDrop and not debounce then
        showToast("🔫 ARMA DROPADA", obj.Name .. " caiu no mapa!", WARN_CLR)
    end
    local conn
    conn = obj.Destroying:Connect(function()
        if GunDrop.HighlightAtual and GunDrop.HighlightAtual.Adornee == obj then
            pcall(function() GunDrop.HighlightAtual:Destroy() end)
            GunDrop.HighlightAtual = nil
        end
        if GunDrop.AvisoColeta and GunDrop.ObjetosMonitorados[obj] then
            showToast("📦 ARMA COLETADA", obj.Name .. " foi pega!", SUCCESS_CLR)
        end
        GunDrop.ObjetosMonitorados[obj] = nil
        if conn then conn:Disconnect() end
    end)
    if GunDrop_CountLbl and GunDrop_CountLbl.Parent then
        GunDrop_CountLbl.Text = "Detectadas: " .. GunDrop.Total
        GunDrop_CountLbl.TextColor3 = WARN_CLR
    end
end

workspace.DescendantAdded:Connect(function(obj)
    if not GunDrop.ESPAtivo and not GunDrop.AvisoDrop
    and not GunDrop.AvisoColeta then return end
    task.wait(0.05)
    GunDrop_Processar(obj)
end)

local function GunDrop_VarrerAgora()
    for _, obj in ipairs(workspace:GetDescendants()) do
        if ehGun(obj) then GunDrop_Processar(obj) end
    end
end

--════════════ Auto Kill (loop por 1s em cada alvo) ════════════
local function clearAlvoHighlight()
    if AutoKillConfig.Highlight then
        pcall(function() AutoKillConfig.Highlight:Destroy() end)
        AutoKillConfig.Highlight = nil
    end
end

local function applyAlvoHighlight(target, cor)
    clearAlvoHighlight()
    if not target or not target.Character then return end
    local hl = Instance.new("Highlight")
    hl.Name = "AKZ_AlvoAtual"
    hl.Adornee = target.Character
    hl.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop
    hl.FillColor = cor
    hl.OutlineColor = cor
    hl.FillTransparency = 0.5
    hl.OutlineTransparency = 0
    hl.Parent = target.Character
    AutoKillConfig.Highlight = hl
end

local function AutoKill_Parar()
    AutoKillConfig.Ativo = false
    AutoKillConfig.Rodando = false
    AutoKillConfig.AlvoAtual = nil
    clearAlvoHighlight()
end

local function AutoKill_ListarAlvos()
    local lista = {}
    for _, p in ipairs(Players:GetPlayers()) do
        if p ~= LocalPlayer and p.Character then
            local hum = p.Character:FindFirstChildOfClass("Humanoid")
            if hum and hum.Health > 0 then
                local role = getPlayerRole(p)
                local ok = false
                if AutoKillConfig.Alvo == "Inocentes" and role == "Innocent" then ok = true end
                if AutoKillConfig.Alvo == "Sheriff"   and role == "Sheriff"  then ok = true end
                if AutoKillConfig.Alvo == "Murder"    and role == "Murderer" then ok = true end
                if ok then
                    table.insert(lista, p)
                end
            end
        end
    end
    return lista
end

local function AutoKill_TpEmCima(target)
    local char = LocalPlayer.Character
    if not char then return false end
    local tChar = target.Character
    if not tChar then return false end
    local tHRP = tChar:FindFirstChild("HumanoidRootPart")
    if not tHRP then return false end
    pcall(function() char:PivotTo(CFrame.new(tHRP.Position + Vector3.new(0, 3, 0))) end)
    return true
end

local function AutoKill_TpPerto(target)
    local char = LocalPlayer.Character
    if not char then return false end
    local tChar = target.Character
    if not tChar then return false end
    local tHRP = tChar:FindFirstChild("HumanoidRootPart")
    if not tHRP then return false end
    local lookVec = tHRP.CFrame.LookVector
    local flatLook = Vector3.new(lookVec.X, 0, lookVec.Z)
    if flatLook.Magnitude < 0.1 then
        flatLook = Vector3.new(0, 0, -1)
    else
        flatLook = flatLook.Unit
    end
    local destino = tHRP.Position - flatLook * AutoKillConfig.Distancia + Vector3.new(0, 3, 0)
    pcall(function() char:PivotTo(CFrame.new(destino)) end)
    return true
end

local function AutoKill_Iniciar()
    if AutoKillConfig.Rodando then return end
    AutoKillConfig.Rodando = true
    AutoKillConfig.Ativo = true
    AutoKillConfig.Trocas = 0
    showToast("🗡️ AUTO KILL", "Modo: " .. AutoKillConfig.Alvo, SUCCESS_CLR)

    task.spawn(function()
        while AutoKillConfig.Ativo do
            local char = LocalPlayer.Character
            local hum = char and char:FindFirstChildOfClass("Humanoid")
            if not char or not hum or hum.Health <= 0 then
                AutoKillConfig.AlvoAtual = "(personagem morto)"
                task.wait(0.5)
            else
                local alvos = AutoKill_ListarAlvos()
                if #alvos == 0 then
                    AutoKillConfig.AlvoAtual = "(sem alvos no mapa)"
                    clearAlvoHighlight()
                    task.wait(1)
                else
                    for _, t in ipairs(alvos) do
                        if not AutoKillConfig.Ativo then break end
                        if t and t.Character then
                            local tHum = t.Character:FindFirstChildOfClass("Humanoid")
                            if tHum and tHum.Health > 0 then
                                AutoKillConfig.AlvoAtual = t.DisplayName
                                AutoKillConfig.Trocas = AutoKillConfig.Trocas + 1

                                local corEsp
                                if AutoKillConfig.Alvo == "Murder" then
                                    corEsp = Color3.fromRGB(220, 40, 40)
                                elseif AutoKillConfig.Alvo == "Sheriff" then
                                    corEsp = Color3.fromRGB(40, 120, 255)
                                else
                                    corEsp = Color3.fromRGB(50, 205, 50)
                                end
                                applyAlvoHighlight(t, corEsp)

                                if AutoKillConfig.Alvo == "Murder" then
                                    AutoKill_TpPerto(t)
                                else
                                    AutoKill_TpEmCima(t)
                                end

                                task.wait(1)
                            end
                        end
                    end
                end
            end
            task.wait(0.1)
        end
        AutoKillConfig.Rodando = false
        clearAlvoHighlight()
    end)
end

--════════════ Ação one-shot: Pegar Gun ════════════
local function AcharGunMaisProxima()
    local char = LocalPlayer.Character
    if not char then return nil end
    local hrp = char:FindFirstChild("HumanoidRootPart")
    if not hrp then return nil end
    if GunDrop.UltimaGun and GunDrop.UltimaGun.Parent then
        return GunDrop.UltimaGun
    end
    local myPos = hrp.Position
    local melhor, melhorDist = nil, math.huge
    for _, obj in ipairs(workspace:GetDescendants()) do
        if ehGun(obj) then
            local dist = (obj.Position - myPos).Magnitude
            if dist < melhorDist then
                melhorDist = dist
                melhor = obj
            end
        end
    end
    return melhor
end

local function PegarGun()
    local gun = AcharGunMaisProxima()
    if not gun then
        showToast("PEGAR GUN", "Nenhuma gun encontrada", DANGER_CLR)
        return
    end
    local char = LocalPlayer.Character
    if not char then return end
    local pos = gun.Position + Vector3.new(0, 2.5, 0)
    pcall(function() char:PivotTo(CFrame.new(pos)) end)
    task.wait(0.1)
    local hrp = char:FindFirstChild("HumanoidRootPart")
    if hrp and firetouchinterest then
        pcall(function()
            firetouchinterest(hrp, gun, 0)
            firetouchinterest(hrp, gun, 1)
        end)
    end
    showToast("PEGAR GUN", "Teleportado pra gun", SUCCESS_CLR)
end

