end

--═══════════════ GUN DROP ═══════════════
local GunDrop = GunDropConfig

local function ehGun(obj)
    if not obj or not obj.Parent then return false end
    if not obj:IsA("BasePart") then return false end
    local p = obj
    while p and p ~= workspace do
        if p:IsA("Model") and Players:GetPlayerFromCharacter(p) then return false end
        p = p.Parent
    end
    local match = checkKeyword(obj.Name, GUN_KEYWORDS)
    if not match then
        for _, c in ipairs(obj:GetChildren()) do
            if checkKeyword(c.Name, GUN_KEYWORDS) then match = true; break end
        end
    end
    if not match and obj.Parent then
        match = checkKeyword(obj.Parent.Name, GUN_KEYWORDS)
    end
    if not match then return false end
    return obj:FindFirstChildOfClass("TouchTransmitter") ~= nil
        or obj:FindFirstChild("TouchInterest") ~= nil
end

local GunDrop_CountLbl

local function GunDrop_Processar(obj)
    if not obj or not obj.Parent then return end
    if GunDrop.ObjetosVistos[obj] then return end
    if not ehGun(obj) then return end
    GunDrop.ObjetosVistos[obj] = true
    GunDrop.Total = GunDrop.Total + 1
    GunDrop.UltimaGun = obj
    GunDrop.ObjetosMonitorados[obj] = true
    local agora = tick()
    local debounce = (agora - GunDrop.UltimoAviso) < 1.5
    GunDrop.UltimoAviso = agora
    if GunDrop.ESPAtivo then
        if GunDrop.HighlightAtual then pcall(function() GunDrop.HighlightAtual:Destroy() end) end
        local hl = Instance.new("Highlight")
        hl.Name = "AKZ_GunDrop_HL"
        hl.Adornee = obj
        hl.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop
        hl.FillColor = WARN_CLR
        hl.OutlineColor = Color3.fromRGB(255, 240, 200)
        hl.FillTransparency = 0.4
        hl.OutlineTransparency = 0
        hl.Parent = obj
        GunDrop.HighlightAtual = hl
    end
    if GunDrop.AvisoDrop and not debounce then
        showToast("🔫 ARMA DROPADA", obj.Name .. " caiu no mapa!", WARN_CLR)
    end
    local conn
    conn = obj.Destroying:Connect(function()
        if GunDrop.HighlightAtual and GunDrop.HighlightAtual.Adornee == obj then
            pcall(function() GunDrop.HighlightAtual:Destroy() end)
            GunDrop.HighlightAtual = nil
        end
        if GunDrop.AvisoColeta and GunDrop.ObjetosMonitorados[obj] then
            showToast("📦 ARMA COLETADA", obj.Name .. " foi pega!", SUCCESS_CLR)
        end
        GunDrop.ObjetosMonitorados[obj] = nil
        if conn then conn:Disconnect() end
    end)
    if GunDrop_CountLbl and GunDrop_CountLbl.Parent then
        GunDrop_CountLbl.Text = "Detectadas: " .. GunDrop.Total
        GunDrop_CountLbl.TextColor3 = WARN_CLR
    end
end

workspace.DescendantAdded:Connect(function(obj)
    if not GunDrop.ESPAtivo and not GunDrop.AvisoDrop
    and not GunDrop.AvisoColeta then return end
    task.wait(0.05)
    GunDrop_Processar(obj)
end)

local function GunDrop_VarrerAgora()
    for _, obj in ipairs(workspace:GetDescendants()) do
        if ehGun(obj) then GunDrop_Processar(obj) end
    end
end

--═══════════════ AUTO KILL (FLING) — preservado ═══════════════
local FlingConfig = {
    Alvo        = "Sheriff",
    TempoMax    = 6,
    DelayVolta  = 4,
    Andando     = false,
    TouchAtivo  = false,
    AutoAtivo   = false,
    Cancelar    = false,
    AlvoAtual   = nil,
    MapaCache   = nil,
}

function FlingConfig.LimitesMapa()
    local container = Farm_PegarContainer()
    if not container then return nil end
    local raiz = container.Parent
    if not raiz or raiz == workspace then raiz = container end

    local c = FlingConfig.MapaCache
    if c and c.raiz == raiz and raiz.Parent then return c.min, c.max end

    local mn, mx
    for _, d in ipairs(raiz:GetDescendants()) do
        if d:IsA("BasePart") then
            local pos = d.Position
            if not mn then
                mn, mx = pos, pos
            else
                mn = Vector3.new(math.min(mn.X, pos.X), math.min(mn.Y, pos.Y), math.min(mn.Z, pos.Z))
                mx = Vector3.new(math.max(mx.X, pos.X), math.max(mx.Y, pos.Y), math.max(mx.Z, pos.Z))
            end
        end
    end
    if not mn then return nil end
    local margem = Vector3.new(80, 150, 80)
    mn, mx = mn - margem, mx + margem
    FlingConfig.MapaCache = { raiz = raiz, min = mn, max = mx }
    return mn, mx
end

function FlingConfig.EmPartida(role, pos, ancoras)
    if role == "Sheriff" or role == "Murderer" then return true end
    local mn, mx = FlingConfig.LimitesMapa()
    if mn then
        return pos.X >= mn.X and pos.X <= mx.X
           and pos.Y >= mn.Y and pos.Y <= mx.Y
           and pos.Z >= mn.Z and pos.Z <= mx.Z
    end
    for _, a in ipairs(ancoras) do
        if (a - pos).Magnitude <= 350 then return true end
    end
    return false
end

local function FlingListarAlvos()
    local ordem = { Sheriff = 1, Murderer = 2, Innocent = 3 }
    local candidatos, ancoras = {}, {}

    for _, p in ipairs(Players:GetPlayers()) do
        if p ~= LocalPlayer and p.Character then
            local h = p.Character:FindFirstChildOfClass("Humanoid")
            local r = p.Character:FindFirstChild("HumanoidRootPart")
            if h and r and h.Health > 0 then
                local role = getPlayerRole(p)
                table.insert(candidatos, { p = p, role = role, pos = r.Position })
                if role ~= "Innocent" then table.insert(ancoras, r.Position) end
            end
        end
    end

    local alvo = FlingConfig.Alvo
    local escolhidos = {}
    for _, c in ipairs(candidatos) do
        local ok = false
        if     alvo == "Todos"     then ok = true
        elseif alvo == "Sheriff"   then ok = (c.role == "Sheriff")
        elseif alvo == "Murder"    then ok = (c.role == "Murderer")
        elseif alvo == "Inocentes" then ok = (c.role == "Innocent") end
        if ok and FlingConfig.EmPartida(c.role, c.pos, ancoras) then
            table.insert(escolhidos, c)
        end
    end

    table.sort(escolhidos, function(x, y) return ordem[x.role] < ordem[y.role] end)

    local lista = {}
    for _, c in ipairs(escolhidos) do table.insert(lista, c.p) end
    return lista
end

local function FlingFoiLancado(tChar, tHum, tHRP, posInicial)
    if not tChar or not tChar.Parent then return true end
    if not tHRP or not tHRP.Parent then return true end
    if tHum and tHum.Health <= 0 then return true end
    if (tHRP.Position - posInicial).Magnitude > 250 then return true end
    if tHRP.AssemblyLinearVelocity.Magnitude > 2000 then return true end
    if tHRP.Position.Y < (workspace.FallenPartsDestroyHeight + 80) then return true end
    return false
end

local function ZerarVelocidade(hrp)
    pcall(function()
        hrp.AssemblyLinearVelocity = Vector3.zero
        hrp.AssemblyAngularVelocity = Vector3.zero
    end)
end

local function TouchEngine(ativoFn, pausarFn, pre)
    local mov = 0.1
    local ang = 0
    while ativoFn() do
        RunService.Heartbeat:Wait()
        local char = LocalPlayer.Character
        local hrp = char and char:FindFirstChild("HumanoidRootPart")
        if hrp and not (pausarFn and pausarFn()) then
            if pre then pre() end
            local vel = hrp.AssemblyLinearVelocity
            local base = vel
            if pre and vel.Magnitude < 1 then
                ang = ang + 1.3
                base = Vector3.new(math.cos(ang) * 16, 0, math.sin(ang) * 16)
            end
            pcall(function()
                hrp.AssemblyLinearVelocity = base * 1e7 + Vector3.new(0, 1e7, 0)
            end)
            RunService.RenderStepped:Wait()
            if pre then pre() end
            pcall(function() hrp.AssemblyLinearVelocity = vel end)
            RunService.Stepped:Wait()
            if pre then pre() end
            pcall(function() hrp.AssemblyLinearVelocity = vel + Vector3.new(0, mov, 0) end)
            mov = -mov
        end
    end
end

local function FlingarAlvo(char, hrp, hum, alvo, origem)
    local tChar = alvo.Character
    local tHum  = tChar and tChar:FindFirstChildOfClass("Humanoid")
    local tHRP  = tHum and tHum.RootPart
    if not tChar or not tHum or not tHRP then return false end
    if tHum.Sit then return false end

    local posInicial = tHRP.Position
    local t0 = tick()
    local lancou = false
    local k, ang, mov = 0, 0, 0.1
    local offsets = {
        Vector3.new(0, 0, 0),   Vector3.new(0.8, 0, 0), Vector3.new(-0.8, 0, 0),
        Vector3.new(0, 0, 0.8), Vector3.new(0, 0, -0.8), Vector3.new(0, 0.8, 0),
    }

    local armado = (getPlayerRole(alvo) == "Murderer")
    local costas = {
        Vector3.new(0, 0, 0.9),    Vector3.new(0.2, 0.2, 0.85),
        Vector3.new(-0.2, -0.2, 0.85), Vector3.new(0, 0.3, 0.8),
    }

    local function colar()
        if not tHRP.Parent or not hrp.Parent then return end
        k = k + 1
        if armado then
            hrp.CFrame = tHRP.CFrame * CFrame.new(costas[(k % #costas) + 1])
        else
            hrp.CFrame = CFrame.new(tHRP.Position + offsets[(k % #offsets) + 1])
        end
    end

    local function voltarOrigem()
        for _ = 1, 3 do
            if not hrp.Parent then return end
            ZerarVelocidade(hrp)
            hrp.CFrame = origem
            pcall(function() char:PivotTo(origem) end)
            RunService.Heartbeat:Wait()
        end
        ZerarVelocidade(hrp)
    end

    local flingThread = task.spawn(function()
        TouchEngine(
            function() return not lancou and (tick() - t0) < FlingConfig.TempoMax end,
            nil,
            colar
        )
    end)

    while (tick() - t0) < FlingConfig.TempoMax do
        if FlingConfig.Cancelar then break end
        if FlingFoiLancado(tChar, tHum, tHRP, posInicial) then
            lancou = true
            break
        end
        task.wait(0.05)
    end

    lancou = true
    pcall(function() task.cancel(flingThread) end)

    voltarOrigem()
    return lancou
end

--═══════════════ AUTO KILL ALL (SEM FLING E SEM TELEPORTE) ═══════════════
local function obterFacaPersonagem()
    local char = LocalPlayer.Character
    local bp   = LocalPlayer:FindFirstChildOfClass("Backpack")
    if char then
        for _, item in ipairs(char:GetChildren()) do
            if item:IsA("Tool") and checkKeyword(item.Name, KNIFE_KEYWORDS) then
                return item
            end
        end
    end
    if bp then
        for _, item in ipairs(bp:GetChildren()) do
            if item:IsA("Tool") and checkKeyword(item.Name, KNIFE_KEYWORDS) then
                return item
            end
        end
    end
    return nil
end

local function equiparEObterFaca()
    local char = LocalPlayer.Character
    if not char then return nil end
    local hum = char:FindFirstChildOfClass("Humanoid")
    if not hum or hum.Health <= 0 then return nil end
    local faca = obterFacaPersonagem()
    if not faca then return nil end
    if faca.Parent ~= char then
        hum:EquipTool(faca)
        task.wait(0.05)
    end
    return faca
end

local function PararAutoKillAll()
    AutoKillAllState.Enabled = false
    AutoKillAllState.Running = false
    if AutoKillAllState.Thread then
        pcall(function() task.cancel(AutoKillAllState.Thread) end)
        AutoKillAllState.Thread = nil
    end
end

local function ExecutarAutoKillAll()
    if AutoKillAllState.Running then return end
    AutoKillAllState.Running = true
    AutoKillAllState.Enabled = true

    AutoKillAllState.Thread = task.spawn(function()
        while AutoKillAllState.Enabled do
            local myRole = getPlayerRole(LocalPlayer)
            if myRole ~= "Murderer" then
                showToast("🔪 AUTO KILL ALL", "Você precisa ser o Murderer!", WARN_CLR)
                break
            end

            local char = LocalPlayer.Character
            local hum = char and char:FindFirstChildOfClass("Humanoid")
            if not char or not hum or hum.Health <= 0 then break end

            local faca = equiparEObterFaca()
            if not faca or not faca.Parent then
                showToast("🔪 AUTO KILL ALL", "Faca não encontrada!", DANGER_CLR)
                break
            end

            local alvos = {}
            for _, p in ipairs(Players:GetPlayers()) do
                if p ~= LocalPlayer and p.Character then
                    local h = p.Character:FindFirstChildOfClass("Humanoid")
                    local r = p.Character:FindFirstChild("HumanoidRootPart")
                    if h and r and h.Health > 0 then
                        local role = getPlayerRole(p)
                        if role == "Innocent" or role == "Sheriff" then
                            table.insert(alvos, { player = p, root = r, hum = h })
                        end
                    end
                end
            end

            if #alvos == 0 then
                showToast("🔪 AUTO KILL ALL", "Nenhum alvo restante!", SUCCESS_CLR)
                break
            end

            -- Sequência de ataque rápido reutilizando a faca equipada do jogo sem Fling/TP
            for _, alvo in ipairs(alvos) do
                if not AutoKillAllState.Enabled then break end
                if not char.Parent or hum.Health <= 0 then break end
                if not faca.Parent then faca = equiparEObterFaca() end
                if not faca then break end

                if alvo.hum.Health > 0 and alvo.root.Parent then
                    -- Direciona brevemente o foco visual da câmera e ativa o golpe da faca nativa
                    pcall(function()
                        Camera.CFrame = CFrame.lookAt(Camera.CFrame.Position, alvo.root.Position)
                    end)
                    faca:Activate()
                end
                task.wait(0.02)
            end

            task.wait(0.1)
        end

        PararAutoKillAll()
    end)
end

--═══════════════ AUTO SHOOT MURDER (CORRIGIDO E BOTÃO FLUTUANTE EXCLUSIVO) ═══════════════
local function LimparHitboxMurderer()
    if AutoShootState.Hitbox then
        pcall(function() AutoShootState.Hitbox:Destroy() end)
        AutoShootState.Hitbox = nil
    end
end

local function ObterJogadorMurderer()
    for _, p in ipairs(Players:GetPlayers()) do
        if p ~= LocalPlayer and p.Character then
            local hum = p.Character:FindFirstChildOfClass("Humanoid")
            if hum and hum.Health > 0 and getPlayerRole(p) == "Murderer" then
                return p, p.Character
            end
        end
    end
    return nil, nil
end

local function CriarHitboxAuxiliarMurderer(mChar)
    LimparHitboxMurderer()
    if not mChar then return end
    local mHRP = mChar:FindFirstChild("HumanoidRootPart")
    if not mHRP then return end

    -- Hitbox local/auxiliar (~15 studs) para servir de suporte na detecção/trava de mira
    local box = Instance.new("Part")
    box.Name = "AKZ_AuxHitbox"
    box.Size = Vector3.new(15, 15, 15)
    box.Transparency = 1
    box.CanCollide = false
    box.Anchored = false
    box.Massless = true
    box.Parent = mChar

    local weld = Instance.new("WeldConstraint")
    weld.Part0 = box
    weld.Part1 = mHRP
    weld.Parent = box
    box.CFrame = mHRP.CFrame

    AutoShootState.Hitbox = box
end

local function ExecutarDisparoAutoShoot()
    if AutoShootState.Executing then return end
    AutoShootState.Executing = true

    local murderer, mChar = ObterJogadorMurderer()
    if not murderer or not mChar then
        showToast("🔫 AUTO SHOOT", "Murderer não encontrado/inválido!", WARN_CLR)
        AutoShootState.Executing = false
        return
    end

    local mHRP = mChar:FindFirstChild("HumanoidRootPart") or mChar:FindFirstChild("Head")
    if not mHRP then
        AutoShootState.Executing = false
        return
    end

    CriarHitboxAuxiliarMurderer(mChar)

    -- Procura a arma Sheriff equipada ou na Backpack
    local char = LocalPlayer.Character
    local bp   = LocalPlayer:FindFirstChildOfClass("Backpack")
    local gun  = nil

    if char then
        for _, item in ipairs(char:GetChildren()) do
            if item:IsA("Tool") and checkKeyword(item.Name, GUN_KEYWORDS) then
                gun = item; break
            end
        end
    end
    if not gun and bp then
        for _, item in ipairs(bp:GetChildren()) do
            if item:IsA("Tool") and checkKeyword(item.Name, GUN_KEYWORDS) then
                gun = item; break
            end
        end
    end

    if not gun then
        showToast("🔫 AUTO SHOOT", "Você não tem a arma de Sheriff!", WARN_CLR)
        LimparHitboxMurderer()
        AutoShootState.Executing = false
        return
    end

    local hum = char and char:FindFirstChildOfClass("Humanoid")
    if hum and gun.Parent ~= char then
        hum:EquipTool(gun)
        task.wait(0.08)
    end

    -- Alinha a câmera diretamente com a hitbox/posição do Murderer
    if mHRP then
        Camera.CFrame = CFrame.lookAt(Camera.CFrame.Position, mHRP.Position)
    end

    -- Disparo usando mecanica nativa e simulações do executor
    pcall(function() gun:Activate() end)
    pcall(function()
        if VirtualInputManager then
            VirtualInputManager:SendMouseButtonEvent(Camera.ViewportSize.X/2, Camera.ViewportSize.Y/2, 0, true, game, 0)
            task.wait(0.02)
            VirtualInputManager:SendMouseButtonEvent(Camera.ViewportSize.X/2, Camera.ViewportSize.Y/2, 0, false, game, 0)
        else
            VirtualUser:CaptureController()
            VirtualUser:ClickButton1(Vector2.new(Camera.ViewportSize.X/2, Camera.ViewportSize.Y/2))
        end
    end)

    task.wait(0.2)
    LimparHitboxMurderer()
    AutoShootState.Executing = false
end

local function CriarBotaoAutoShoot()
    if AutoShootState.Button and AutoShootState.Button.Parent then return end

    local btnFrame = Instance.new("Frame")
    btnFrame.Name = "AKZ_AutoShootButton"
    btnFrame.AnchorPoint = Vector2.new(0.5, 0.5)
    btnFrame.Position = UDim2.new(0.5, 0, 0, 55)
    btnFrame.Size = UDim2.new(0, 210, 0, 42)
    btnFrame.BackgroundColor3 = Color3.fromRGB(18, 18, 22)
    btnFrame.BackgroundTransparency = 0.2
    btnFrame.BorderSizePixel = 0
    btnFrame.Active = true
    btnFrame.ZIndex = 100
    btnFrame.Parent = screenGui

    Instance.new("UICorner", btnFrame).CornerRadius = UDim.new(0, 10)

    local stroke = Instance.new("UIStroke", btnFrame)
    stroke.Color = Theme.Accent
    stroke.Thickness = 1.5

    local txt = Instance.new("TextLabel", btnFrame)
    txt.Size = UDim2.new(1, 0, 1, 0)
    txt.BackgroundTransparency = 1
    txt.Text = "🔫 SHOOT MURDER"
    txt.Font = Enum.Font.GothamBold
    txt.TextSize = 13
    txt.TextColor3 = TEXT

    -- Arraste compatível com Mouse e Touch sem acionar clique
    local dragging = false
    local dragStart, startPos
    local dragThreshold = 8
    local wasDragged = false

    btnFrame.InputBegan:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
            dragging = true
            wasDragged = false
            dragStart = input.Position
            startPos = btnFrame.Position
        end
    end)

    UserInputService.InputChanged:Connect(function(input)
        if dragging and (input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch) then
            local delta = input.Position - dragStart
            if delta.Magnitude > dragThreshold then
                wasDragged = true
            end
            btnFrame.Position = UDim2.new(
                startPos.X.Scale,
                startPos.X.Offset + delta.X,
                startPos.Y.Scale,
                startPos.Y.Offset + delta.Y
            )
        end
    end)

    UserInputService.InputEnded:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
            if dragging then
                dragging = false
                if not wasDragged then
                    ExecutarDisparoAutoShoot()
                end
            end
        end
    end)

    AutoShootState.Button = btnFrame
end

local function DesativarAutoShoot()
    AutoShootState.Enabled = false
    AutoShootState.Executing = false
    if AutoShootState.Button then
        AutoShootState.Button:Destroy()
        AutoShootState.Button = nil
    end
    LimparHitboxMurderer()
    if AutoShootState.Connection then
        AutoShootState.Connection:Disconnect()
        AutoShootState.Connection = nil
    end
end

local function AtivarAutoShoot()
    AutoShootState.Enabled = true
    CriarBotaoAutoShoot()

    if not AutoShootState.Connection then
        AutoShootState.Connection = RunService.Heartbeat:Connect(function()
            if not AutoShootState.Enabled then return end
            -- Valida e limpa a hitbox se o Murderer morrer ou sair da partida
            if AutoShootState.Hitbox and AutoShootState.Hitbox.Parent then
                local mChar = AutoShootState.Hitbox.Parent
                local hum = mChar:FindFirstChildOfClass("Humanoid")
                if not hum or hum.Health <= 0 then
                    LimparHitboxMurderer()
                end
            end
        end)
    end
end

