-- Transparência (CORRIGIDO)
--   • guarda o valor original uma única vez (attribute)
--   • se chamado de novo com o mesmo estado, não faz nada
--   • nunca acumula transparência
-- ────────────────────────────────────────────────────────────
local function Transp_AplicarEm(obj)
    if not obj:IsA("GuiObject") then return end
    if obj:GetAttribute("AKZ_OrigBT") ~= nil then return end
    local bt = obj.BackgroundTransparency
    if bt >= 0.9 then return end
    obj:SetAttribute("AKZ_OrigBT", bt)
    obj.BackgroundTransparency = math.min(0.88, bt + 0.5)
end

local function Transp_RestaurarEm(obj)
    if not obj:IsA("GuiObject") then return end
    local orig = obj:GetAttribute("AKZ_OrigBT")
    if orig ~= nil then
        obj.BackgroundTransparency = orig
        obj:SetAttribute("AKZ_OrigBT", nil)
    end
end

local function Transp_Aplicar(ativar)
    if TranspState.ativo == ativar then return end
    TranspState.ativo = ativar
    if ativar then
        menuFrame.BackgroundTransparency = 0.4
        for _, obj in ipairs(menuFrame:GetDescendants()) do Transp_AplicarEm(obj) end
    else
        menuFrame.BackgroundTransparency = 0
        for _, obj in ipairs(menuFrame:GetDescendants()) do Transp_RestaurarEm(obj) end
    end
end

