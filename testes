local menuOpen = false
local function openMenu()
    if menuOpen then return end
    menuOpen = true
    menuFrame.Visible = true
    menuFrame.Size = LAYOUTS[CurrentLayout]
    menuScale.Scale = 0.75
    menuFrame.Position = UDim2.new(0.5, 0, 0.5, 25)
    TweenService:Create(menuScale, TweenInfo.new(0.42, Enum.EasingStyle.Back, Enum.EasingDirection.Out), {Scale=1}):Play()
    TweenService:Create(menuFrame, TweenInfo.new(0.32, Enum.EasingStyle.Quint, Enum.EasingDirection.Out), {
        Position = UDim2.new(0.5, 0, 0.5, 0)
    }):Play()
end
local function closeMenu()
    if not menuOpen then return end
    menuOpen = false
    TweenService:Create(menuScale, TweenInfo.new(0.22, Enum.EasingStyle.Quint, Enum.EasingDirection.In), {Scale=0.75}):Play()
    local t = TweenService:Create(menuFrame, TweenInfo.new(0.22, Enum.EasingStyle.Quint, Enum.EasingDirection.In), {
        Position = UDim2.new(0.5, 0, 0.5, 25)
    })
    t:Play()
    t.Completed:Connect(function() if not menuOpen then menuFrame.Visible = false end end)
end
closeBtn.MouseButton1Click:Connect(closeMenu)

local logoDragging, logoDragStart, logoStartPos, logoMoved = false, nil, nil, false
logo.InputBegan:Connect(function(input)
    if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
        logoDragging = true; logoMoved = false
        logoDragStart = input.Position; logoStartPos = logo.Position
        input.Changed:Connect(function()
            if input.UserInputState == Enum.UserInputState.End then
                logoDragging = false
                if not logoMoved then
                    if menuOpen then closeMenu() else openMenu() end
                end
            end
        end)
    end
end)
UserInputService.InputChanged:Connect(function(input)
    if not logoDragging then return end
    if input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch then
        local delta = input.Position - logoDragStart
        if math.abs(delta.X) > 3 or math.abs(delta.Y) > 3 then logoMoved = true end
        logo.Position = UDim2.new(logoStartPos.X.Scale, logoStartPos.X.Offset + delta.X,
            logoStartPos.Y.Scale, logoStartPos.Y.Offset + delta.Y)
    end
end)

